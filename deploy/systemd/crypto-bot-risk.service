[Unit]
Description=Crypto Trading Machine — Independent Risk Manager (stop-loss/take-profit/trailing)
# Runs alongside (NOT instead of) crypto-bot.service. Only enable this unit
# if app/config.py's risk_loop_in_process_enabled is set to False — otherwise
# the main app process already runs the same loop in-process and you'd be
# running it twice (harmless due to the kv-backed cross-process lock in
# app/trading/risk_loop.py, but pointless).
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cryptobot
Group=cryptobot
UMask=0077
WorkingDirectory=/opt/crypto-trading-machine
Environment=PYTHONUNBUFFERED=1
Environment=APP_ENV_FILE=/var/lib/crypto-bot/.env
EnvironmentFile=-/var/lib/crypto-bot/.env
ExecStart=/opt/crypto-trading-machine/.venv/bin/python -m app.trading.risk_loop
Restart=always
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/crypto-bot /opt/crypto-trading-machine/data /opt/crypto-trading-machine/logs

[Install]
WantedBy=multi-user.target
