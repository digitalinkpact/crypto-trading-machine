[Unit]
Description=Crypto Trading Machine API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/crypto-trading-machine
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/crypto-trading-machine/.env
ExecStart=/opt/crypto-trading-machine/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
