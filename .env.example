# Binance.US API credentials (https://www.binance.us/usercenter/settings/api-management)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional LLM providers
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Runtime
ENV=dev
LOG_LEVEL=INFO

# Optional app access guard (HTTP Basic). Set both to enable.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# Trading safety — KEEP TRUE UNTIL YOU MEAN IT
DRY_RUN=true
PAPER_TRADING=true

# Risk
MAX_POSITION_PCT=0.10
MAX_PORTFOLIO_RISK_PCT=0.25
KELLY_FRACTION_CAP=0.25
MAX_OPEN_POSITIONS=50
MAX_LONG_EXPOSURE_PCT=0.95
MIN_ORDER_USDT=10.0
# Trade bigger on higher-conviction signals (floor multiplier at the entry bar).
CONFIDENCE_SIZING_ENABLED=true
CONFIDENCE_SIZING_FLOOR=0.5
# Daily realized-loss guard — halts new BUYs past this fraction of start equity.
DAILY_LOSS_LIMIT_ENABLED=true
DAILY_LOSS_LIMIT_PCT=0.05

# Exit ladder (all optional — code defaults shown)
STOP_LOSS_PCT=0.04
ATR_STOP_ENABLED=true
ATR_STOP_MULTIPLE=2.0
ATR_STOP_MIN_PCT=0.03
ATR_STOP_MAX_PCT=0.08
TAKE_PROFIT_1_PCT=0.08
TAKE_PROFIT_1_FRACTION=0.50
TAKE_PROFIT_2_PCT=0.15
TAKE_PROFIT_2_FRACTION=0.25
TRAILING_STOP_PCT=0.03
TRAILING_ACTIVATION_PCT=0.05
TRAILING_REQUIRES_TP1=false
STALE_EXIT_ENABLED=true
STALE_EXIT_HOURS=48
STALE_EXIT_MAX_PNL_PCT=0.02

# Entry gates / selectivity (fewer, higher-conviction trades = less fee churn)
MIN_SIGNAL_CONFIDENCE=0.72
BUY_COOLDOWN_MINUTES=90

# Entry strategy (dip_buy | oversold_bounce) + selectivity
ENTRY_STRATEGY=oversold_bounce
PROFITSTREAM_SCORE_THRESHOLD=80
MEAN_REVERSION_EXIT_ENABLED=false
# ProfitStream is the PRIMARY live strategy. Set PROFITSTREAM_USE_LEGACY_AGENTS
# =true only to fall back to the (noisier, historically lower-win-rate) legacy
# multi-agent ensemble.
PROFITSTREAM_ENABLED=true
PROFITSTREAM_USE_LEGACY_AGENTS=false

# Watchdog / independent risk loop
EMERGENCY_HALT_ENABLED=true
RISK_LOOP_IN_PROCESS_ENABLED=true
RISK_MANAGER_LOOP_SECONDS=15
ML_LABEL_SLIPPAGE_PCT=0.0010

# ML learning loop
ML_LEARNING_ENABLED=true
ML_SIGNAL_HORIZON_MINUTES=240
ML_MIN_TRAINING_SAMPLES=200
ML_MIN_NEW_LABELS=50

# Storage
DATA_CACHE_DIR=./data/cache
